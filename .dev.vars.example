# Copy to .dev.vars for `npm run dev` (wrangler dev). Never commit .dev.vars.
# Use a separate *dev* bot from @BotFather so local testing never touches the real one.
BOT_TOKEN=123456:replace-me
# Any long random string; Telegram echoes it in the X-Telegram-Bot-Api-Secret-Token header.
WEBHOOK_SECRET=replace-with-a-long-random-string
# Optional. Without any AI key the bot only uses the built-in question deck.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
